{
  "expo": {
    "name": "Media Player",
    "slug": "media-player",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "media-player",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mediaplayer.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "We need access to your media library to display your local audio and video files."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121212"
      },
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_AUDIO",
        "READ_MEDIA_VIDEO"
      ],
      "package": "com.mediaplayer.app"
    },
    "plugins": [
      "expo-router",
      [
        "expo-media-library",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to access your media.",
          "savePhotosPermission": "Allow $(PRODUCT_NAME) to save media.",
          "isAccessMediaLocationEnabled": true
        }
      ]
    ]
  }
}
